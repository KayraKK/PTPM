cat > .gitignore <<'EOF'
# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/

# ---------- Виртуальные окружения ----------
.venv/
venv/
env/
ENV/

# ---------- Coverage ----------
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.pytest_cache/

# ---------- IDE ----------
.idea/
.vscode/
*.swp
*.swo

# ---------- OS ----------
.DS_Store
Thumbs.db

# ---------- Прочее ----------
*.log
EOF